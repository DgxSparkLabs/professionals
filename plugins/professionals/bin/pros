    "adhoc_listen_s": 3300,  # an idle ad hoc session's listener waits this long after its turn for a message (hook timeout 3600)
    "max_live": 6, "max_depth": 4, "idle_reap_min": 30, "deliver_deadline_s": 600,
    "stuck_min": 10, "default_mode": "bypassPermissions", "model": "", "summon_budget_per_hour": 20,
    "task_msg_cap": 20, "max_blocks": 10, "ready_timeout_s": 60, "ack_timeout_s": 15,
    "max_ask_wait_s": 100, "auto_reply": True, "delivering_recover_s": 30, "pump_interval_s": 5, "trusted_marketplaces": [], "deny_paths": [], "sandbox": "auto",
    "publish_guard": "", "resume_max_days": 14, "max_resends": 1, "max_attempts": 2, "deadline_extend_max_s": 7200,
    "wake_on_send": True, "failover": True, "msg_retention_days": 30,
    "auto_unblock": True,  # a denial that no deny rule caused is unblocked by pros itself (entry auto_unblock: false turns it off)
    "blocked_models": ["fable"],  # a model whose name contains one of these runs only when the user stored it on that professional's entry
}
DEFAULT_DENY = ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/gh", "~/.netrc", "~/.claude/.credentials.json"]

BYPASS = "bypassPermissions"  # 0.6.0 default: every tool, deny rules still enforced (Claude Code: "Deny rules block in every mode")

# What a persona's `tools:` line may grant under a stricter mode (R6).  Anything else is dropped.
SAFE_TOOLS = {"Read", "Glob", "Grep", "Edit", "Write", "NotebookEdit", "WebFetch", "WebSearch", "TodoWrite"}
