             "Bash(git show*)", "Bash(git blame*)", "Bash(git ls-files*)", "Bash(git ls-tree*)"]
SAFE_BASH_SANDBOXED = ["Bash(ls*)", "Bash(cat *)", "Bash(grep *)", "Bash(rg *)", "Bash(find *)",
                       "Bash(head *)", "Bash(tail *)", "Bash(wc *)", "Bash(diff *)"]

# Harnesses (0.7.0): the agent program a professional runs in.  proto "claude": Claude Code in tmux, messages by the Stop hook
# or paste.  proto "pi-rpc": `pros bridge` in tmux drives the program over Pi's JSONL RPC protocol (no Stop hook there).
