{
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pros\" hook sessionstart", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pros\" hook userpromptsubmit", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pros\" hook stop", "timeout": 10}]}],
    "Notification": [{"matcher": "permission_prompt", "hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pros\" hook notification", "timeout": 10}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pros\" hook sessionend", "timeout": 10}]}]
  }
}
